# Host ports of the docker compose stack (copy to .env to override).
# If you change them, adapt the app settings when running it outside docker, e.g.:
#   ConnectionStrings__Postgres="Host=localhost;Port=<POSTGRES_PORT>;Database=temporal_poc;Username=poc;Password=poc"
#   Temporal__Address=localhost:<TEMPORAL_PORT>   Storage__ServiceUrl=http://localhost:<S3_PORT>
POSTGRES_PORT=55432
S3_PORT=8333
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=18080
API_PORT=5055

# Demo mode of the api service (files generated automatically at startup + continuous flow)
DEMO_ENABLED=true
DEMO_INITIAL_FILES=300
DEMO_FILES_PER_MINUTE=17
DEMO_PROCESSING_EVERY_MINUTES=5
