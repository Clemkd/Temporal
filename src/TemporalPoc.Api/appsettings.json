{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Temporalio": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=55432;Database=temporal_poc;Username=poc;Password=poc;Maximum Pool Size=100"
  },
  "Temporal": {
    "Address": "localhost:7233",
    "Namespace": "default"
  },
  "Worker": {
    "Enabled": true,
    "TaskQueues": [],
    "MaxConcurrentActivities": 32,
    "MaxConcurrentWorkflowTasks": 32,
    "GracefulShutdownSeconds": 10
  },
  "Storage": {
    "Provider": "S3",
    "Bucket": "sensor-files",
    "ServiceUrl": "http://localhost:8333",
    "AccessKey": "poc",
    "SecretKey": "poc-secret",
    "RootPath": "./data/objects"
  },
  "Watcher": {
    "AutoStart": true,
    "ScanIntervalSeconds": 15,
    "MaxFilesPerScan": 2000,
    "MaxInFlight": 0,
    "OrphanAfterMinutes": 10,
    "Pipeline": "file-ingestion"
  },
  "Chaos": {
    "TransientFailureRate": 0.0,
    "PoisonMarker": "poison",
    "SlowMarker": "slow",
    "SlowSeconds": 30
  }
}
